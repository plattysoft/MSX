FILE "../res/sprites.bin.plet5"
FILE "../gen/flappas.chr.plet5"
FILE "../gen/flappas.clr.plet5"
FILE "../gen/flappas_0_0.plet5"
FILE "../gen/flappas_1_0.plet5"
' CLRSCR
FILE "../gen/sfx.akx"
FILE "../gen/flappas.akm"

1 COLOR 15,1,1
2 SCREEN 2,2,0
4 DEFINT A-U
5 ' V- Velocity and Y-position are double
9 DIM PX(3),PE(3),PY(3,5),BT(32)

20 CMD PLYLOAD 6, 5
21 CMD PLYSONG 2:CMD PLYPLAY ' Song 2 is silent, but we want SFX

30 GOSUB 4000 ' Initial load
40 'GOSUB 4100 ' Load play screen
50 GOTO 5000 ' Initial screen

1500 ' Move pipe
1510 PX(I)=PX(I)-2
1520 IF PX(I)<=-15 THEN PE(I)=0
1529 ' Score can be done based on T as well
1530 'IF PX(I)=49 THEN SC=SC+1:CMD PLYSOUND 3:GOSUB 8000:TX=8:TY=23:GOSUB 10900
1599 RETURN

1600 ' Draw Pipe 1
1601 IF PE(0)=0 THEN 1631
1602 P1=PX(0)
1611 PUT SPRITE 1,(P1,PY(0,0))
1612 PUT SPRITE 2,(P1,PY(0,1))
1613 PUT SPRITE 3,(P1,PY(0,2))
1614 PUT SPRITE 4,(P1,PY(0,3))
1615 PUT SPRITE 5,(P1,PY(0,4))
1616 PUT SPRITE 6,(P1,PY(0,5))
1620 RETURN
1631 PUT SPRITE 1,,,9
1632 PUT SPRITE 2,,,9
1633 PUT SPRITE 3,,,9
1634 PUT SPRITE 4,,,9
1635 PUT SPRITE 5,,,9
1636 PUT SPRITE 6,,,9
1649 RETURN

1650 ' Draw Pipe 2
1651 IF PE(1)=0 THEN 1671
1652 P1=PX(1)
1661 PUT SPRITE 7,(P1,PY(1,0))
1662 PUT SPRITE 8,(P1,PY(1,1))
1663 PUT SPRITE 9,(P1,PY(1,2))
1664 PUT SPRITE 10,(P1,PY(1,3))
1665 PUT SPRITE 11,(P1,PY(1,4))
1666 PUT SPRITE 12,(P1,PY(1,5))
1670 RETURN
1671 PUT SPRITE 7,,,9
1672 PUT SPRITE 8,,,9
1673 PUT SPRITE 9,,,9
1674 PUT SPRITE 10,,,9
1675 PUT SPRITE 11,,,9
1676 PUT SPRITE 12,,,9
1679 RETURN

1700 ' Draw Pipe 3
1701 IF PE(2)=0 THEN 1731
1702 P1=PX(2)
1711 PUT SPRITE 13,(P1,PY(2,0))
1712 PUT SPRITE 14,(P1,PY(2,1))
1713 PUT SPRITE 15,(P1,PY(2,2))
1714 PUT SPRITE 16,(P1,PY(2,3))
1715 PUT SPRITE 17,(P1,PY(2,4))
1716 PUT SPRITE 18,(P1,PY(2,5))
1720 RETURN
1731 PUT SPRITE 13,,,9
1732 PUT SPRITE 14,,,9
1733 PUT SPRITE 15,,,9
1734 PUT SPRITE 16,,,9
1735 PUT SPRITE 17,,,9
1736 PUT SPRITE 18,,,9
1749 RETURN

1750 ' Spawn Pipe
1751 PH=RND(1)*5
1760 FOR I=0 TO PH
1761   PY(CP,I)=16*I+7
1762 NEXT I
1763 FOR I=PH TO 5
1771  PY(CP,I)=16*I+103
1772 NEXT I
1775 PY(CP,4)=PH*16+7
1776 PY(CP,5)=PH*16+87
1777 PX(CP)=255:PE(CP)=1:SP=CP*6
1781 PUT SPRITE 1+SP,(PX(CP),PY(CP,0)),2,8
1782 PUT SPRITE 2+SP,(PX(CP),PY(CP,1)),2,5
1783 PUT SPRITE 3+SP,(PX(CP),PY(CP,2)),2,8
1784 PUT SPRITE 4+SP,(PX(CP),PY(CP,3)),2,5
1785 PUT SPRITE 5+SP,(PX(CP),PY(CP,4)),2,7
1786 PUT SPRITE 6+SP,(PX(CP),PY(CP,5)),2,6
1790 CP=CP+1:IF CP=3 THEN CP=0
1799 RETURN

1800 'fun remap bricks
1801 RETURN
1802 FOR I=1 TO 6:VPOKE 256+I,BT(BI):VPOKE 4096+256+I,BT(BI):BI=BI+1:NEXT
1808 IF BI=32 THEN BI=0
1809 RETURN
1810 aa=aa*4:ab=ab*4' THis is the old one
1820 if aa=256 THEN aa=0:ab=1
1830 if ab=256 THEN ab=0:aa=1
1840 VPOKE 1, aa: VPOKE 4097, aa: VPOKE 9, ab: VPOKE 4105, ab
1850 VPOKE 2, aa: VPOKE 4098, aa: VPOKE 10, ab: VPOKE 4106, ab
1860 VPOKE 3, aa: VPOKE 4099, aa: VPOKE 11, ab: VPOKE 4107, ab
1870 VPOKE 4, aa: VPOKE 4100, aa: VPOKE 12, ab: VPOKE 4108, ab
1880 VPOKE 5, aa: VPOKE 4101, aa: VPOKE 13, ab: VPOKE 4109, ab
1890 VPOKE 6, aa: VPOKE 4102, aa: VPOKE 14, ab: VPOKE 4119, ab
1899 RETURN

4000 ' Load sprites from binary file
4001 CMD WRTVRAM 0, &H3800 ' Load sprites WRTSPRPAT
4002 CMD WRTCHR 1:CMD WRTCLR 2
4010 ' Load brick scrolling in an array
4020 FOR I=0 TO 31: BT(I)=VPEEK(264+I):NEXT
4099 RETURN

4100 CMD WRTCHR 1:CMD WRTCLR 2
4150 RETURN

5000 ' Start screen
5001 'CMD WRTSCR 45
5011 'CMD PLYMUTE:CMD PLYSONG 1 ' Main screen sound
5020 CMD WRTSCR 4 ' Main screen
5021 CMD PLYPLAY ' Start the music on the main start screen
5030 IF STRIG(0) OR STRIG(1) THEN 5030 'debounce string press
5090 IF STRIG(0) THEN SS=0:GOTO 6000
5091 IF STRIG(1) THEN SS=1:GOTO 6000
5099 GOTO 5090

6000 ' Main Game
6001 CMD WRTSCR 3
6002 'CMD PLYMUTE:CMD PLYSONG 0:CMD PLYPLAY' Actual main song
6003 A=RND(-TIME)
6010 V=0: Y=100:aa=0:ab=1:SC=0
6020 FOR I=0 TO 3:PE(I)=0:NEXT I
6030 BS=0:SS=1:T=0:ST=0' BS - Bird Sprite, ST=Sprite tick
6040 ' Flap and scroll until space is pressed once
6050 TIME=0
6051 PUT SPRITE 0,(50,Y),11,BS
6052 ST=ST+1:IF ST=4 THEN ST=0:BS=BS+1:IF BS=4 THEN BS=0' Bird sprite update
6060 GOSUB 1800
6070 S=STRIG(0): IF S=0 THEN SS=0 ELSE IF SS=0 THEN V=-3:SS=1:CMD PLYSOUND 8:GOTO 6094
6090 IF TIME<1 GOTO 6090 ELSE 6040
6094 SPRITE ON:ON SPRITE GOSUB 6500
6100 ' ********************
6102 ' *    GAME LOOP     *
6104 ' ********************
6105 TIME=0
6110 PUT SPRITE 0,(50,Y),11,BS
6111 GOSUB 1600:GOSUB 1650:GOSUB 1700'Draw the pipes (unwind)
6120 S=STRIG(0): IF S=0 THEN SS=0 ELSE IF SS=0 THEN V=-3:SS=1:IF FX<0 THEN CMD PLYSOUND 8
6140 Y=Y+V
6150 V=V+.15
6160 ST=ST+1:IF ST=4 THEN ST=0:BS=BS+1:IF BS=4 THEN BS=0' Bird sprite update
6180 GOSUB 1800 ' Remap bricks,4
6200 ' PIPE MOVEMENT (unwind)
6210 IF PE(0) THEN PX(0)=PX(0)-2:IF PX(0)<=-15 THEN PE(0)=0 ELSE IF PX(0)=49 THEN GOSUB 6450
6211 IF PE(1) THEN PX(1)=PX(1)-2:IF PX(1)<=-15 THEN PE(1)=0 ELSE IF PX(1)=49 THEN GOSUB 6450
6212 IF PE(2) THEN PX(2)=PX(2)-2:IF PX(2)<=-15 THEN PE(2)=0 ELSE IF PX(2)=49 THEN GOSUB 6450
6350 FX=FX-1:T=T+1:IF T=45 THEN T=0:GOSUB 1750' Spawn pipe
6380 IF Y>=152 OR Y<=7 THEN GOTO 6500' Game over by hitting walls
6391 IF TIME<1 THEN FR=2 ELSE FR=8 ' Frame Rate drop detection
6392 PUT SPRITE 31,(174,174),FR,0
6399 IF TIME<1 GOTO 6399
6400 GOTO 6100

6450 SC=SC+1:CMD PLYSOUND 3:FX=9:GOSUB 8000:TX=8:TY=23:GOSUB 10900'FX means a SFX is playing with priority and should not play another one (jump)
6451 RETURN

6500 ' ********************
6502 ' *    GAME OVER     *
6504 ' ********************
6505 'CMD PLYMUTE:CMD PLYSONG 2:CMD PLYPLAY ' Song 2 is silent
6506 SPRITE OFF
6507 V=-4:T=0
6508 CMD PLYSOUND 4
6510 PUTSPRITE 0,(50,Y),11,4
6530 Y=Y+V+.3*T*4
6540 T=T+1
6549 IF TIME>2 THEN TIME=0 ELSE GOTO 6549
6550 IF Y>=152 THEN GOTO 6600
6560 GOTO 6510
6600 ' ********************
6602 ' *  START NEW GAME  *
6604 ' ********************
6605 'PRESS SPACE TO START
6610 GOSUB 10300
6650 ' Clean all sprites
6641 FOR I=0 TO 31: PUT SPRITE I,,,9:NEXT
6690 GOTO 5000

8000 ' Prepare score T$
8075 T$=STR$(SC):T$=RIGHT$(T$,LEN(T$)-1)
8076 IF SC<1000 THEN T$="0"+T$
8077 IF SC<100 THEN T$="0"+T$
8078 IF SC<10 THEN T$="0"+T$
8099 RETURN

10300 ' fun Display a pop-up
10301 KS=&H18C5
10309 ' Hide only the sprites that are behind the popup
10310 ' Pipes (TODO)
10311 FOR I=0 TO 2
10312   IF PX(I)<24 OR PX(I)>216 THEN 10319
10316   FOR J=0 TO 6
10317      IF PY(I,J)>23 AND PY(I,J)<112 THEN PUT SPRITE I*6+J+1,,0,0
10318   NEXT J
10319 NEXT I

10320 VPOKE KS,96:FOR J=1 to 20:VPOKE KS+J,97:NEXT J:VPOKE KS+21, 98
10321 FOR I=1 TO 8 'Rows
10322   KR=KS+I*32
10323   VPOKE KR, 128
10330   FOR J=1 to 20 'Columns
10340     VPOKE KR+J, 0
10350   NEXT J
10351   VPOKE KR+21, 130
10360 NEXT I
10370 KS=&H19C5:VPOKE KS,160:FOR J=1 to 20:VPOKE KS+J,161:NEXT J:VPOKE KS+21, 162
10371 CMD PLYSOUND 3
10375 TX=6:TY=7:GOSUB 10900
10376 TIME=0' Show the dialog for at least 30 frames
10378 IF STRIG(SS) THEN 10378
10379 IF TIME<30 OR NOT STRIG(SS) THEN 10379

10380 ' Dismiss dialog
10381 CMD PLYSOUND 4
10382 ' Reload the entire screen
10383 CMD WRTSCR 4
10388 IF STRIG(SS) THEN 10388
10390 RETURN

10900 'fun Write text T$ on Screen at position TX, TY (in row/column)
10901 TF=0
10910 FOR I=1 TO LEN(T$)
10911   TF=TF+1
10920   CT$=MID$(T$,i,1)
10940   IF CT$=" " THEN TT=0:GOTO 10949
10941   IF CT$="#" THEN TF=0:TY=TY+2:GOTO 10950
10942   IF CT$="@" THEN TF=TF-1:GOTO 10950 ' Non printable character
10943   TT=ASC(CT$)+127 ' A is 65, it is located at 192
10944   IF TT<192 THEN TT=TT+49 'Fix the gap on the ASCII numbers and the letters.(0-9 are 48 to 57)
10949   VPOKE &H1800+TX-1+TY*32+TF, TT
10950 NEXT I
10990 RETURN



