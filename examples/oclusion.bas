1 SCREEN 2,2,0
10 DEFINT A-Z
20 DIM S(32), T(32), CT(4)
30 FOR I=0 TO 31: READ R:S(I)=R:VPOKE I+&H3800,R:NEXT I
40 FOR I=0 TO 31: READ R:T(I)=R:VPOKE I+8,R:NEXT I

42 FOR I=0 TO 792: VPOKE &H1800+I,0: NEXT
50 FOR C=2 TO 30 STEP 4:R=6
60 VPOKE &H1800+&H20*R+C, 1:VPOKE &H1800+&H20*R+C+1, 2
70 VPOKE &H1800+&H20*R+C+&H20, 3:VPOKE &H1800+&H20*R+C+&H20+1, 4
80 NEXT C

100 TI=&H20*(Y/8)+(X/8)
110 CT(0) = VPEEK(&H1800+TI-&H20)
111 CT(1) = VPEEK(&H1800+TI)
112 CT(2) = VPEEK(&H1820+TI)
113 CT(3) = VPEEK(&H1801+TI)
114 CT(4) = VPEEK(&H1821+TI)

120 SS=STICK(0)
130 IF SS=1 AND CT(1)<3 AND CT(3)<3 THEN Y=Y-1
140 IF SS=3 THEN X=X+1
150 IF SS=5 AND CT(2)<3 AND CT(4)<3 THEN Y=Y+1
160 IF SS=7 THEN X=X-1

190 GOSUB 700

290 PUT SPRITE 0,(X,Y-1),1,0
299 IF TIME<2 THEN 299 ELSE TIME=0:GOTO 100

650 'Oclusion
651 ' For non 8 bit movement, this needs to update each time. More complicated
652 ' Need to find a way to say we are in foreground (if tile is is not occluding, use normal
660 IF CT(1)>0 AND CT(1)<3 THEN FOR I=0 TO 7: VPOKE I+&H3800,S(I) AND NOT VPEEK(CT(1)*8+I):NEXT ELSE FOR I=0 TO 7: VPOKE I+&H3800,S(I):NEXT
670 FOR I=0 TO 7: VPOKE I+&H3808,S(I+8) AND NOT VPEEK(CT(2)*8+I):NEXT
680 IF CT(3)>0 AND CT(3)<3 THEN FOR I=0 TO 7: VPOKE I+&H3810,S(I+16) AND NOT VPEEK(CT(3)*8+I):NEXT ELSE FOR I=0 TO 7: VPOKE I+&H3810,S(I+16):NEXT
690 FOR I=0 TO 7: VPOKE I+&H3818,S(I+24) AND NOT VPEEK(CT(4)*8+I):NEXT
699 RETURN

700 'Pixel perfect by Y oclusion
701 OY=Y MOD 8
702 FOR I=OY TO 7:VPOKE I-OY+&H3800,S(I-OY) AND NOT VPEEK(CT(0)*8+I):NEXT
' 703 FOR I=0 TO 7: VPOKE I+8-OY+&H3800,S(I+8-OY) AND NOT VPEEK(CT(1)*8+I):NEXT
704 FOR I=0 TO 7-OY: VPOKE I+OY+&H3808,S(I+8+OY) AND NOT VPEEK(CT(2)*8+I):NEXT
720 'FOR I=0 TO 7: VPOKE I+&H3808,S(I+8) AND NOT VPEEK(CT(2)*8+I):NEXT
730 'IF CT(3)>0 AND CT(3)<3 THEN FOR I=0 TO 7: VPOKE I+&H3810,S(I+16) AND NOT VPEEK(CT(3)*8+I):NEXT ELSE FOR I=0 TO 7: VPOKE I+&H3810,S(I+16):NEXT
740 'FOR I=0 TO 7: VPOKE I+&H3818,S(I+24) AND NOT VPEEK(CT(4)*8+I):NEXT
799 RETURN

1000 DATA &H07,&H1F,&H3F,&H7F,&H7F,&HFF,&HFF,&HFF
1010 DATA &HFF,&HFF,&H7F,&H7F,&H3F,&H1F,&H07,&H00
1020 DATA &HC0,&HF0,&HF8,&HFC,&HFC,&HFE,&HFE,&HFE
1030 DATA &HFE,&HFE,&HFC,&HFC,&HF8,&HF0,&HC0,&H00

1040 DATA &H00,&H00,&H00,&H00,&H00,&H00,&H01,&H03
1050 DATA &H00,&H00,&H00,&H00,&H40,&HE0,&HE0,&HE0
1060 DATA &H07,&H07,&H07,&H0F,&H3F,&H7F,&H7F,&HFF
1070 DATA &HF0,&HF0,&HF8,&HF8,&HFC,&HFC,&HFE,&HFF
